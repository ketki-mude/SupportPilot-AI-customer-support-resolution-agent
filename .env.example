# Copy to .env and fill in the blanks: cp .env.example .env
# Empty values are treated as unset.

# --- Host ports (change these if something else on your machine already uses them)
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
MOCK_COMMERCE_HOST_PORT=8001

# --- App
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database
POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=
POSTGRES_DB=supportpilot
# Used only when you run backend code on your host. Docker compose points the backend at the
# db service itself, and tests use the "<POSTGRES_DB>_test" database.
DATABASE_URL=postgresql+asyncpg://supportpilot:<POSTGRES_PASSWORD>@localhost:5432/supportpilot
# TEST_DATABASE_URL=

# --- Auth. Generate the secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- LLM (gemini, anthropic, or openai). Check Google AI Studio for the current model name.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportpilot

# --- Business rule thresholds (enforced in code, never in prompts)
REFUND_WINDOW_DAYS=30
AUTO_APPROVE_MAX_USD=50
SUPERVISOR_APPROVAL_MAX_USD=500
MIN_CONFIDENCE=0.6

# --- Mock commerce API
MOCK_COMMERCE_URL=http://localhost:8001
# Share of requests that fault (0 to 1). Each fault is a 503 or, MOCK_SLOW_FRACTION of the
# time, a response delayed by MOCK_SLOW_SECONDS. Set MOCK_RANDOM_SEED for repeatable runs.
MOCK_FAILURE_RATE=0
MOCK_SLOW_FRACTION=0.5
MOCK_SLOW_SECONDS=2
MOCK_RANDOM_SEED=

# --- Demo user passwords used by `make seed` (choose your own)
SEED_CUSTOMER_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_PASSWORD=
